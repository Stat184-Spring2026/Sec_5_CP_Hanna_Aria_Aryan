#Line Plot for Monthly Change in Percent

monthly_change_eggs <- ggplot(data_clean |> filter(!is.na(`1-Month % Change`)),
                      aes(x = Date, y = `1-Month % Change`)) +
  geom_line(color = "red", linewidth = 1) +
  theme_minimal() +
  labs(
    title = "Grade A Eggs Price Over Time",
    subtitle = "1 Month Percent Change",
    x = "Year",
    y = "% Change"
  ) +
  theme(plot.title = element_text(face = "bold"))

#Area Plot for Prices

value_area_eggs <- ggplot(data_clean |> filter(!is.na(Value)),
                          aes(x = Date, y = Value)) +
  geom_area(alpha = 0.75, fill = 'blue') +
  theme_minimal() +
  labs(
    title = "Grade A Eggs Price Over Time",
    x = "Year",
    y = "Price ($)"
  ) +
  theme_minimal()
